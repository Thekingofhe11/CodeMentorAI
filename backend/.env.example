# auto prefers Gemini when configured, then OpenAI. Use gemini or openai to pin a provider.
AI_PROVIDER=auto

# Leave keys blank for the local demo. Keep real keys only in backend/.env.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also supported if GEMINI_API_KEY is blank.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional existing OpenAI integration.
OPENAI_API_KEY=

# A Responses API model available to your API project. Change as needed.
OPENAI_MODEL=gpt-6-astra
